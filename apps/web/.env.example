# Public site URL (used for sitemap, OG tags, llms.txt, Astro `site`)
PUBLIC_SITE_URL=http://localhost:3100

# Shared session secret for admin and Auth.js OAuth (required in production). Generate with: openssl rand -base64 32
AUTH_SECRET=

# OAuth providers (optional, for guestbook social sign in)
# GitHub: https://github.com/settings/developers  → callback http://localhost:3100/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google: https://console.cloud.google.com/apis/credentials → callback http://localhost:3100/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Admin login is NOT in env. Edit packages/db/seeds/admin.json then:
#   npm run db:migrate
#   npm run db:seed:admin

# Neon Postgres — https://console.neon.tech → your project → Connection string (pooled)
# then run once from the repo root: npm run db:migrate
DATABASE_URL=

# Mail — Resend (preferred). Inbox notifications when someone contacts you.
# Free test sender works without domain verify: onboarding@resend.dev
# After you verify ranasami.dev in Resend, switch MAIL_FROM to e.g. Portfolio <hello@ranasami.dev>
RESEND_API_KEY=
MAIL_FROM=Ranasami <onboarding@resend.dev>
MAIL_TO=ranasami0909@gmail.com
# Optional: "true" sends visitors a short "got your message" confirmation
# (best after domain verify — otherwise may land in spam)
MAIL_AUTOREPLY=false

# SMTP fallback (optional if RESEND_API_KEY is set)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
#        SMTP_PASS=<16-char App Password from https://myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional: raises GitHub API rate limit for live stats
GITHUB_TOKEN=

# Image uploads (admin) — Vercel Blob (production). Without this token, uploads
# save to apps/web/public/uploads/ (local/dev only; fine for testing).
# Create at: https://vercel.com/dashboard → Storage → Blob → .env BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=
