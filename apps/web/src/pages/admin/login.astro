---
import { SectionLabel } from "@repo/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AdminLoginForm } from "@/components/admin-login-form";
import { getSession } from "@/lib/session";

export const prerender = false;

const session = await getSession(Astro.cookies);
if (session?.isAdmin) {
  return Astro.redirect("/admin");
}
---

<BaseLayout title="Admin login" description="Admin sign-in" canonical="/admin/login">
  <div class="container-x flex min-h-[70dvh] items-center justify-center pb-24 pt-16">
    <div class="w-full max-w-md">
      <SectionLabel index="AD">Admin</SectionLabel>
      <h1 class="mt-5 font-medium text-4xl tracking-tight">Sign in</h1>
      <p class="mt-3 text-muted">Email + password for the seeded admin account.</p>
      <AdminLoginForm client:load />
    </div>
  </div>
</BaseLayout>
