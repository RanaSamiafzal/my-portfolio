---
import { Card, SectionLabel, Tag } from "@repo/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { StatusBadge } from "@/components/project-card";
import { ProjectInsideVisual, ProjectVisual } from "@/components/project-visual";
import { Reveal } from "@/components/reveal";
import { loadProject, loadProjects } from "@/lib/content";

export const prerender = false;

const slug = Astro.params.slug!;
const [project, projects] = await Promise.all([loadProject(slug), loadProjects()]);

if (!project?.caseStudy) {
  return Astro.redirect("/work");
}

const cs = project.caseStudy;
const withCases = projects.filter((p) => p.caseStudy);
const next = withCases[(withCases.findIndex((p) => p.slug === project.slug) + 1) % withCases.length]!;
const hasInside = ["brandly", "aide", "spendwise"].includes(project.slug);
---

<BaseLayout title={`${project.name} — case study`} description={project.summary} canonical={`/work/${project.slug}`}>
  <article class="container-x pb-24 pt-16 md:pt-24">
    <a href="/work" class="font-mono text-xs text-muted-soft hover:text-accent">← ALL WORK</a>
    <div class="mt-10">
      <SectionLabel index="CS">
        {project.context} · {project.period}
      </SectionLabel>
      <h1 class="h-display mt-6 text-[clamp(3rem,8vw,6.5rem)]">{project.name}</h1>
      <p class="mt-4 max-w-[40ch] text-xl text-accent md:text-2xl">{project.tagline}</p>
    </div>

    <div class="relative mt-14">
      <ProjectVisual client:load slug={project.slug} image={project.image} imageUrl={project.imageUrl} className="relative" />
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1.6fr_1fr]">
      <div class="space-y-6 text-lg leading-relaxed text-muted">
        <p>{project.summary}</p>
        <p>{cs.problem}</p>
      </div>
      <Card className="h-fit p-6">
        <dl class="space-y-4 text-sm">
          <div>
            <dt class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-soft">Role</dt>
            <dd class="mt-1 text-text">{cs.role}</dd>
          </div>
          <div>
            <dt class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-soft">Status</dt>
            <dd class="mt-1.5">
              <StatusBadge status={project.status} />
            </dd>
          </div>
          <div>
            <dt class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-soft">Stack</dt>
            <dd class="mt-2 flex flex-wrap gap-1.5">
              {project.stack.map((s) => <Tag>{s}</Tag>)}
            </dd>
          </div>
          {
            project.links.length > 0 && (
              <div>
                <dt class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-soft">Links</dt>
                <dd class="mt-2 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs">
                  {project.links.map((l) => (
                    <a href={l.href} target="_blank" rel="noreferrer" class="text-accent hover:underline">
                      {l.label} ↗
                    </a>
                  ))}
                </dd>
              </div>
            )
          }
        </dl>
      </Card>
    </div>

    {
      hasInside && (
        <section class="mt-24 grid items-center gap-10 lg:grid-cols-[1fr_1.3fr]">
          <div>
            <SectionLabel>Inside the product</SectionLabel>
            <h2 class="mt-6 text-3xl font-medium tracking-tight md:text-4xl">What users actually work with</h2>
            <p class="mt-4 leading-relaxed text-muted">
              An illustrative view of the core workflow, with sample data — the screen where the product earns its keep.
            </p>
          </div>
          <ProjectInsideVisual client:load slug={project.slug} />
        </section>
      )
    }

    <section class="mt-24">
      <SectionLabel index="01">Architecture</SectionLabel>
      <div class="mt-8 overflow-hidden rounded-2xl border border-line">
        {
          cs.architecture.map((a, i) => (
            <Reveal
              client:visible
              delay={i * 60}
              className="grid gap-2 border-line px-6 py-5 sm:grid-cols-[260px_1fr] [&:not(:last-child)]:border-b"
            >
              <code class="font-mono text-sm text-accent">{a.name}</code>
              <p class="text-muted">{a.detail}</p>
            </Reveal>
          ))
        }
      </div>
    </section>

    <section class="mt-24">
      <SectionLabel index="02">What I built</SectionLabel>
      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          cs.highlights.map((h, i) => (
            <Reveal client:visible delay={i * 60}>
              <Card className="h-full p-6">
                <p class="font-mono text-xs text-accent">{String(i + 1).padStart(2, "0")}</p>
                <h3 class="mt-4 text-xl font-medium tracking-tight">{h.title}</h3>
                <p class="mt-2 leading-relaxed text-muted">{h.body}</p>
              </Card>
            </Reveal>
          ))
        }
      </div>
    </section>

    <section class="mt-24 grid gap-10 lg:grid-cols-[1fr_1.6fr]">
      <div>
        <SectionLabel index="03">Decisions</SectionLabel>
        <h2 class="mt-6 text-3xl font-medium tracking-tight">Trade-offs worth explaining.</h2>
      </div>
      <ol class="space-y-5">
        {
          cs.decisions.map((d) => (
            <li class="flex gap-4 leading-relaxed text-muted">
              <span class="font-mono text-sm text-accent">→</span>
              {d}
            </li>
          ))
        }
        {
          cs.next && (
            <li class="flex gap-4 leading-relaxed text-muted">
              <span class="font-mono text-sm text-accent-soft">next</span>
              {cs.next}
            </li>
          )
        }
      </ol>
    </section>

    <a href={`/work/${next.slug}`} class="group mt-28 flex items-end justify-between gap-6 border-t border-line pt-10">
      <div>
        <p class="font-mono text-xs text-muted-soft">NEXT CASE STUDY</p>
        <p class="mt-3 text-[clamp(2rem,5vw,4rem)] font-medium leading-none tracking-tight transition-colors group-hover:text-accent">
          {next.name}
        </p>
      </div>
      <span class="font-mono text-3xl text-accent transition-transform group-hover:translate-x-2">→</span>
    </a>
  </article>
</BaseLayout>
