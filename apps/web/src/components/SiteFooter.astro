---
import { LocalTime } from "./local-time";
import type { SiteSettings } from "@repo/db";

interface Props { settings: SiteSettings }
const { settings } = Astro.props;
const { profile } = settings;
---

<footer class="relative z-10 mt-4 border-t border-line sm:mt-8">
  <div class="container-x grid grid-cols-2 gap-x-6 gap-y-8 py-8 sm:gap-y-10 sm:py-12 md:grid-cols-[1.4fr_1fr_1fr] md:gap-12 md:py-16">
    <div class="col-span-2 md:col-span-1">
      <a href="/" class="font-display text-2xl font-semibold tracking-tight">
        sami<span class="text-accent">.</span>
      </a>
      <p class="mt-3 max-w-[36ch] text-pretty text-sm leading-relaxed text-muted md:mt-4">
        Full stack engineer building real time, AI powered web products from Lahore, for teams anywhere.
      </p>
      <p class="mt-4 inline-flex items-center gap-2 rounded-full border border-line px-3 py-1 font-mono text-[11px] text-muted md:mt-5">
        <span class="size-1.5 rounded-full bg-accent"></span> Lahore · <LocalTime client:load /> PKT
      </p>
    </div>
    <div>
      <p class="mono-label mb-3 md:mb-4">Pages</p>
      <ul class="space-y-2 text-sm md:space-y-2.5">
        {
          settings.navLinks.map((l) => (
            <li>
              <a href={l.href} class="text-muted transition-colors hover:text-accent">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="mono-label mb-3 md:mb-4">Connect</p>
      <ul class="space-y-2 text-sm md:space-y-2.5">
        <li>
          <a class="text-muted hover:text-accent" href={profile.socials.github} target="_blank" rel="noreferrer">GitHub ↗</a>
        </li>
        <li>
          <a class="text-muted hover:text-accent" href={profile.socials.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
        </li>
        <li>
          <a class="break-all text-muted hover:text-accent" href={`mailto:${profile.email}`}>{profile.email}</a>
        </li>
        <li>
          <a class="text-muted hover:text-accent" href={profile.cv} target="_blank">Download CV ↓</a>
        </li>
        <li>
          <a class="text-muted hover:text-accent" href="/llms.txt">llms.txt</a>
        </li>
      </ul>
    </div>
  </div>
  <div class="container-x flex flex-col gap-2 border-t border-line py-5 font-mono text-[11px] text-muted-soft sm:flex-row sm:flex-wrap sm:justify-between sm:gap-3 sm:py-6">
    <span>© {new Date().getFullYear()} {profile.name}. All rights reserved.</span>
    <span>Built with Astro · React · Three.js</span>
  </div>
</footer>
