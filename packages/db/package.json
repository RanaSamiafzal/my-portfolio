{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@repo/content": "*"
  },
  "devDependencies": {
    "@repo/tsconfig": "*",
    "tsx": "^4.23.15"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file-if-exists=../../apps/web/.env.local scripts/migrate.mjs",
    "seed:admin": "node --env-file-if-exists=../../apps/web/.env.local scripts/seed-admin.mjs",
    "seed:content": "node --env-file-if-exists=../../apps/web/.env.local --import tsx scripts/seed-content.mjs"
  }
}
