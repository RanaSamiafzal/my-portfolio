{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "AUTH_*",
        "BLOB_*",
        "DATABASE_URL",
        "GITHUB_TOKEN",
        "SMTP_*",
        "MAIL_*",
        "NEXT_PUBLIC_*"
      ]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "typecheck": { "dependsOn": ["^typecheck"] }
  }
}
