{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".vercel/output/**"
      ],
      "env": [
        "AUTH_*",
        "BLOB_*",
        "DATABASE_URL",
        "GITHUB_TOKEN",
        "SMTP_*",
        "MAIL_*",
        "PUBLIC_*",
        "RESEND_API_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "AUTH_*",
        "BLOB_*",
        "DATABASE_URL",
        "GITHUB_TOKEN",
        "SMTP_*",
        "MAIL_*",
        "PUBLIC_*",
        "RESEND_API_KEY"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    }
  }
}
